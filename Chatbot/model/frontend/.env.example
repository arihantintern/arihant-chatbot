# Copy to `.env.local` (which git ignores) and adjust if your API is elsewhere.
#
# Only variables prefixed VITE_ are exposed to the browser — which also means
# everything here ends up in the built bundle. Never put a secret in this file.

# Where model/api.py is listening. Its own README runs it with
#   uvicorn api:app --reload
# which serves on 127.0.0.1:8000. Whatever you point this at must also be
# listed in the CORS `allow_origins` in model/api.py.
VITE_API_BASE_URL=http://127.0.0.1:8000
